---
interface Props { items: string[]; dark?: boolean; tilt?: number }
const { items, dark = false, tilt = 0 } = Astro.props;
const row = [...items, ...items];
---
<div class:list={['marquee', { 'marquee--dark': dark }]} style={`--tilt:${tilt}deg`} aria-hidden="true">
  <div class="marquee__track" data-marquee>
    {[0, 1].map(() => (
      <div class="marquee__group">
        {row.map((t) => (
          <span class="marquee__item">{t}<svg viewBox="0 0 64 64" class="marquee__paw"><use href="#paw" /></svg></span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  .marquee {
    position: relative; z-index: 4; /* por encima del marco: rompe los bordes laterales */
    background: var(--red); color: var(--paper);
    transform: rotate(var(--tilt)); margin: 0;
    border-block: 1px solid var(--line-strong); /* mismo borde que las láminas */
    overflow: hidden; padding: clamp(22px, 3vw, 42px) 0;
  }
  .marquee--dark { background: var(--ink); color: var(--paper); }
  .marquee__track { display: flex; width: max-content; will-change: transform; }
  .marquee__group { display: flex; flex: none; }
  .marquee__item {
    display: inline-flex; align-items: center; gap: .5em; padding-right: .5em;
    font-size: clamp(1.8rem, 5vw, 4rem); font-weight: 500; text-transform: uppercase; white-space: nowrap; line-height: 1;
  }
  .marquee__paw { width: .8em; height: .8em; fill: currentColor; transform: rotate(-14deg); }
</style>
