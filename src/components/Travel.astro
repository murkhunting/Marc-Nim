---
import SheetHead from './SheetHead.astro';

// Solo cambia la ruta entre pestañas; los consejos son fijos.
const tabs = [
  {
    id: 'pty',
    label: 'Desde Panamá',
    route: [
      { code: 'PTY', city: 'Panamá' },
      { code: 'MAD', city: 'Madrid', leg: '~10 h · directo' },
      { code: 'IBZ', city: 'Ibiza', leg: '~1 h 15' },
    ],
  },
  {
    id: 'otro',
    label: 'Desde otro origen',
    route: [
      { code: 'TÚ', city: 'Tu ciudad' },
      { code: 'MAD', city: 'Madrid o Barcelona', leg: 'Vuelo a España' },
      { code: 'IBZ', city: 'Ibiza', leg: '~1 h' },
    ],
  },
];

const tips = [
  ['Vuelos internacionales', 'Lo mejor es volar primero a Madrid o Barcelona y, desde allí, buscar una compañía low cost hasta Ibiza. Los vuelos directos al aeropuerto de Ibiza suelen costar bastante más.'],
  ['Vuelos dentro de España', 'Las compañías más económicas suelen ser Ryanair o Vueling. Si miráis con tiempo, el precio puede salir muy bien.'],
  ['Documentación', 'Pasaporte en vigor, o DNI si venís de la UE. Para estancias cortas no hace falta visado, pero comprobad antes de viajar si ya se exige la autorización ETIAS.'],
  ['Moverse por la isla', 'Muy recomendable alquilar coche: Sant Carles está en el noreste, a unos 30 min del aeropuerto, y el autobús no llega a todas partes. De noche hay pocos taxis: reservad con antelación.'],
];

const zones = [
  { name: 'Santa Eulària des Riu', dist: '~10 min', text: 'Pueblo con paseo marítimo, playa y muchos restaurantes. Nuestra recomendación principal.' },
  { name: 'Sant Carles y alrededores', dist: '~5 min', text: 'Agroturismos y casas rurales entre pinos. Tranquilidad total.' },
  { name: 'Es Canar · Cala Llonga', dist: '~10–15 min', text: 'Hoteles junto al mar, buena opción para familias.' },
  { name: 'Ibiza ciudad', dist: '~25 min', text: 'Más oferta y ambiente, con Dalt Vila y el puerto a mano.' },
];
---
<section id="viaje" class="travel section--flush" data-flush data-section="viaje">
  <SheetHead
    n={5}
    label="Accesos y logística"
    title={'Viaje y\nalojamiento'}
    sub="Vendrá gente de Panamá, de Barcelona y de donde haga falta. Aquí tenéis cómo llegar y dónde dormir cerca de la boda."
  />
  <div class="sheet-content">

    <div class="tabs" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="Origen del viaje">
        {tabs.map((t, i) => (
          <button role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class="tabs__tab mono" data-tab={t.id}>
            {t.label}
          </button>
        ))}
      </div>

      {tabs.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="tabs__panel" data-panel={t.id} hidden={i !== 0}>
          <div class="route" aria-label={`Ruta: ${t.route.map((r) => r.city).join(' → ')}`}>
            {t.route.map((r, j) => (
              <>
                {j > 0 && (
                  <div class="route__leg">
                    <span class="route__line" aria-hidden="true"><svg viewBox="0 0 24 24" class="route__plane"><path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5Z" /></svg></span>
                    <span class="mono route__time">{r.leg}</span>
                  </div>
                )}
                <div class="route__stop">
                  <span class="route__code">{r.code}</span>
                  <span class="mono route__city">{r.city}</span>
                </div>
              </>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Consejos fijos: tarjetas al 50 % en dos filas, no cambian con la pestaña -->
    <div class="tips">
      {tips.map(([k, v], i) => (
        <article class="tip">
          <p class="mono tip__k">{String(i + 1).padStart(2, '0')} - {k}</p>
          <p class="tip__v">{v}</p>
        </article>
      ))}
    </div>

    <div class="stay">
      <div class="stay__head">
        <h3 class="h3">Alojamiento en Ibiza</h3>
        <p class="mono stay__meta">Distancias en coche hasta Sant Carles</p>
      </div>
      <div class="stay__grid">
        {zones.map((z, i) => (
          <article class="zone" data-reveal>
            <div class="zone__top mono"><span>Zona {String.fromCharCode(65 + i)}</span><span class="red">{z.dist}</span></div>
            <h4 class="zone__name">{z.name}</h4>
            <p class="zone__text">{z.text}</p>
          </article>
        ))}
        <article class="zone zone--soon" data-reveal data-cuqui-hover="Estoy negociando descuentos. Pago en latas.">
          <div class="zone__top mono"><span>Recomendados</span><span>En obras</span></div>
          <h4 class="zone__name">Hoteles y casas</h4>
          <p class="zone__text">Pronto pondremos aquí sitios concretos y, si podemos, algún descuento para invitados.</p>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  /* La lámina va a sangre: las pestañas quedan pegadas al borde superior */
  :global(.travel .sheet-content) { padding: 0; }

  /* Pestañas: mismo estilo que los filtros del mapa de Ibiza (tira pegada, relleno que sube) */
  .tabs__list { display: flex; border-bottom: 1px solid var(--frame-line, var(--line-strong)); background: var(--paper); }
  .tabs__tab {
    position: relative; flex: 1 1 0; min-height: 56px; padding: 0 20px;
    background: none; border: 0; border-right: 1px solid var(--frame-line, var(--line-strong)); border-radius: 0;
    color: var(--ink); overflow: hidden; isolation: isolate; white-space: nowrap;
    transition: color .4s var(--ease);
  }
  .tabs__tab:last-child { border-right: 0; }
  .tabs__tab::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--red);
    transform: translateY(101%); border-radius: 50% 50% 0 0;
    transition: transform .5s var(--ease), border-radius .5s var(--ease);
  }
  /* Inactiva: fondo un poco más oscuro. Activa: el fondo claro de la página (sin verde) */
  .tabs__tab { background: var(--paper-2); }
  .tabs__tab[aria-selected='true'] { background: var(--paper); }
  .tabs__tab[aria-selected='true']::before { display: none; }
  .tabs__tab[aria-selected='false']:hover, .tabs__tab[aria-selected='false']:focus-visible { color: #fff; }
  .tabs__tab[aria-selected='false']:hover::before, .tabs__tab[aria-selected='false']:focus-visible::before { transform: translateY(0); border-radius: 0; }
  .tabs__panel { padding: clamp(28px, 4vw, 48px) var(--pad-x); border-bottom: 1px solid var(--frame-line, var(--line-strong)); }

  .route { display: flex; align-items: center; gap: 12px; }
  .route__stop { display: grid; flex: none; }
  .route__code { font-size: clamp(2.4rem, 9vw, 6rem); line-height: .9; font-weight: 500; letter-spacing: -0.02em; }
  .route__city { color: var(--ink-3); }
  .route__leg { flex: 1; display: grid; gap: 6px; min-width: 40px; }
  .route__line { position: relative; height: 18px; display: block; }
  .route__line::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; border-top: 1.5px dashed var(--ink); }
  .route__plane { position: absolute; top: 0; left: 0; width: 18px; height: 18px; fill: var(--red); transform: rotate(90deg); animation: fly 3.2s var(--ease) infinite; }
  @keyframes fly { from { left: 0; } to { left: calc(100% - 18px); } }
  .route__time { color: var(--ink-2); font-size: 10.5px; text-align: center; }

  .tips { display: grid; }
  .tip { padding: clamp(20px, 3vw, 32px) var(--pad-x); border-bottom: 1px solid var(--frame-line, var(--line-strong)); display: grid; gap: 10px; align-content: start; }
  .tip p { margin: 0; }
  .tip__k { color: var(--ink); }
  .tip__v { color: var(--ink-2); max-width: 52ch; }

  .stay { padding: clamp(40px, 6vw, 80px) var(--pad-x); }
  .stay__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 18px; }
  .stay__head .h3 { font-size: clamp(1.8rem, 4vw, 3rem); text-transform: uppercase; font-weight: 500; }
  .stay__meta { color: var(--ink-3); margin: 0; }
  .stay__grid { display: grid; gap: 12px; }
  .zone { border: 1px solid var(--line-strong); padding: 16px; display: grid; gap: 8px; align-content: start; background: color-mix(in srgb, var(--paper) 70%, white); }
  .zone__top { display: flex; justify-content: space-between; }
  .zone__name { margin: 0; font-size: 1.3rem; font-weight: 600; text-transform: uppercase; line-height: 1.1; }
  .zone__text { margin: 0; color: var(--ink-2); }
  .zone--soon { border-style: dashed; background: transparent; }

  @media (min-width: 760px) {
    .tips { grid-template-columns: 1fr 1fr; }
    /* línea central: borde derecho de la columna izquierda (alineada con el resto de láminas) */
    .tip:nth-child(odd) { border-right: 1px solid var(--frame-line, var(--line-strong)); }
    .stay__grid { grid-template-columns: repeat(3, 1fr); }
  }
  /* Móvil: solo los códigos y los aviones, para que PTY · MAD · IBZ (o TÚ · MAD · IBZ) quepa siempre dentro del recuadro */
  @media (max-width: 639px) {
    .route { gap: 6px; }
    .route__code { font-size: clamp(1.9rem, 9.5vw, 2.8rem); }
    .route__stop, .route__leg { min-width: 0; }
    .route__leg { min-width: 20px; }
    .route__city, .route__time { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .route__plane { animation: none; left: 50%; } }
</style>
