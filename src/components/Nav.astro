---
import { nav, wedding } from '../data/site';
const pad = (n: number) => String(n).padStart(2, '0');
---
<header class="nav" data-nav>
  <div class="nav__bar">
    <a href="#inicio" class="nav__logo" data-scroll="inicio" aria-label="Marc & Nim · Volver al inicio" data-cursor="paw">
      <span class="sign" data-sign>
        <span class="sign__face sign__face--front" aria-hidden="true"><span class="sign__fit" data-fit data-max="44">Marc &amp; Nim</span></span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Secciones">
      {nav.filter((item) => item.id !== 'inicio').map((item) => (
        <a href={`#${item.id}`} data-scroll={item.id} data-nav-link={item.id} class="nav__link">
          <span class="nav__roll" data-text={item.label}><span>{item.label}</span></span>
        </a>
      ))}
    </nav>

    <div class="nav__right">
      <a href="#rsvp" data-scroll="rsvp" class="btn nav__cta">Confirmar <span class="arrow">→</span></a>
      <button class="nav__burger mono" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="nav__burger-label" data-open-label>Menú</span>
        <span class="nav__burger-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu aria-hidden="true">
  <div class="menu__inner">
    <div class="menu__head mono">
      <span>Índice de láminas</span>
      <span>{wedding.number}</span>
    </div>
    <ol class="menu__list">
      {nav.map((item, i) => (
        <li>
          <a href={`#${item.id}`} data-scroll={item.id} class="menu__link" tabindex="-1">
            <span class="mono menu__num">L-{pad(i + 1)}</span>
            <span class="menu__label">{item.label}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="menu__foot">
      <img src="/img/cuqui.jpg" alt="" class="menu__cuqui" width="298" height="348" />
      <p class="note">Elige lámina.<br />Yo ya he elegido siesta.</p>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 900;
    transition: transform .5s var(--ease);
  }
  .nav__bar {
    height: var(--nav-h);
    display: flex; align-items: center; justify-content: space-between; gap: 0;
    padding: 0 var(--gutter) 0 0;
    padding-top: env(safe-area-inset-top);
    background: var(--paper);
    border-bottom: 1px solid var(--line-strong);
  }
  .nav__logo { display: flex; align-items: center; text-decoration: none; flex: none; }
  .nav__logo { perspective: 700px; flex: 1 1 auto; min-width: 0; }
  .sign {
    position: relative; display: block;
    width: 100%; height: var(--nav-h);
    
  }
  .sign__face {
    position: absolute; inset: 0; display: grid; place-items: center;
    -webkit-backface-visibility: hidden; backface-visibility: hidden;
    background: transparent; color: var(--ink);
    white-space: nowrap; overflow: hidden;
  }
  .sign__face--front { font-family: var(--f-rough); font-size: 30px; line-height: 1; padding-top: 3px; text-align: center; overflow: visible; }
  .sign__fit { display: inline-block; white-space: nowrap; line-height: 1; }
  .nav__links { display: none; }
  .nav__link {
    position: relative; display: flex; align-items: center; justify-content: center;
    font-family: var(--f-futura); font-weight: 500; font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; overflow: hidden; isolation: isolate;
    transition: color .4s var(--ease);
  }
  /* un solo borde como separador: entre el logo y el primer botón y entre botones; sin borde en el extremo derecho */
  .nav__link { border-left: 1px solid var(--line-strong); }
  /* relleno del botón */
  .nav__link::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--red);
    transform: translateY(101%); border-radius: 50% 50% 0 0;
    transition: transform .5s var(--ease), border-radius .5s var(--ease);
  }
  .nav__link:hover::before, .nav__link.is-active::before { transform: translateY(0); border-radius: 0; }
  /* ¿Vienes?: fondo oscuro en reposo; al pasar el ratón se rellena como los demás */
  .nav__link[data-nav-link='rsvp'] { background: var(--ink); color: #fff; }
  /* texto que gira y pasa a blanco */
  .nav__roll { position: relative; display: inline-block; overflow: hidden; line-height: 1.5; }
  .nav__roll > span { display: inline-block; transition: transform .45s var(--ease); }
  .nav__roll::after {
    content: attr(data-text); position: absolute; left: 0; top: 100%; color: #fff;
    transition: transform .45s var(--ease);
  }
  .nav__link:hover .nav__roll > span, .nav__link:hover .nav__roll::after { transform: translateY(-100%); }
  .nav__link.is-active .nav__roll > span, .nav__link.is-active .nav__roll::after { transform: translateY(-100%); }

  .nav__right { display: flex; align-items: center; gap: 10px; }
  .nav__cta { min-height: 40px; padding: 0 16px; font-size: 11px; }
  .nav__burger {
    display: inline-flex; align-items: center; gap: 10px;
    min-height: 40px; padding: 0 14px;
    border: 1px solid var(--line-strong); border-radius: 999px; background: transparent;
    font-family: var(--f-futura); font-weight: 500; font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
  }
  .nav__burger-icon { display: grid; gap: 4px; width: 16px; }
  .nav__burger-icon i { display: block; height: 1.5px; background: currentColor; transition: transform .4s var(--ease); }
  .nav__burger[aria-expanded='true'] .nav__burger-icon i:first-child { transform: translateY(2.75px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] .nav__burger-icon i:last-child { transform: translateY(-2.75px) rotate(-45deg); }


  @media (max-width: 420px) {
    .nav__cta { display: none; }
  }
  @media (min-width: 1180px) {
    /* botones iguales, pegados a la derecha; el espacio sobrante es para el logo */
    .nav__bar { padding-right: 0; align-items: stretch; }
    .nav__logo { align-self: center; }
    .nav__right { display: none; }
    .nav__links {
      display: grid; grid-template-columns: repeat(8, 1fr);
      width: min(80vw, 8 * 150px); margin-left: auto;
      width: round(down, min(80vw, 8 * 150px), 8px); /* columnas de píxeles enteros: el separador no se ve más grueso */
    }
  }

  /* Menú overlay */
  .menu {
    position: fixed; inset: 0; z-index: 890;
    background: var(--ink); color: var(--paper);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    overflow-y: auto;
  }
  .menu.is-open { visibility: visible; }
  .menu__inner {
    min-height: 100%;
    padding: calc(var(--nav-h) + 24px) var(--gutter) 32px;
    display: flex; flex-direction: column; gap: 24px;
  }
  .menu__head { display: flex; justify-content: space-between; color: var(--ink-3); border-bottom: 1px solid rgba(235,235,237,.2); padding-bottom: 10px; }
  .menu__list { list-style: none; margin: 0; padding: 0; }
  .menu__list li { border-bottom: 1px solid rgba(235,235,237,.12); overflow: hidden; }
  .menu__link {
    display: flex; align-items: baseline; gap: 16px;
    padding: 10px 0; text-decoration: none;
  }
  .menu__num { font-family: var(--f-futura); display: inline-block; color: var(--red); min-width: 40px; }
  .menu__label {
    display: inline-block; font-family: var(--f-futura);
    font-size: clamp(2rem, 9vw, 3.4rem); line-height: 1.05; text-transform: uppercase; font-weight: 500;
    transition: color .3s;
  }
  .menu__link:hover .menu__label, .menu__link:focus-visible .menu__label { color: var(--red); }
  .menu__foot { margin-top: auto; display: flex; align-items: flex-end; gap: 14px; }
  .menu__cuqui { width: 84px; height: auto; border-radius: 42px 42px 0 0; filter: grayscale(1); }
  .menu .note { color: var(--paper); font-size: 1.5rem; margin: 0; }
  .nav.menu-open .nav__bar { background: transparent; border-color: transparent; color: var(--paper); -webkit-backdrop-filter: none; backdrop-filter: none; }
  .nav.menu-open .sign__face--front { color: var(--paper); }
  .nav.menu-open .nav__burger { border-color: rgba(235,235,237,.5); }
  .nav.menu-open .nav__cta { --bg: var(--paper); --fg: var(--ink); }
</style>
