---
import { nav, wedding } from '../data/site';
const pad = (n: number) => String(n).padStart(2, '0');
// Láminas 01–07 = de Historia a Preguntas. «Inicio» y «¿Vienes?» (resolución) no llevan número.
const lamina = (id: string) => { const i = nav.filter((x) => x.id !== 'inicio' && x.id !== 'rsvp').findIndex((x) => x.id === id); return i < 0 ? null : pad(i + 1); };
---
<header class="nav" data-nav>
  <div class="nav__bar">
    <a href="#inicio" class="nav__logo" data-scroll="inicio" aria-label="Marc & Nim · Volver al inicio" data-cursor="paw">
      <span class="sign" data-sign>
        <span class="sign__face sign__face--front" aria-hidden="true"><span class="sign__fit" data-fit data-max="44">Marc &amp; Nim</span></span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Secciones">
      {nav.filter((item) => item.id !== 'inicio').map((item) => (
        <a href={`#${item.id}`} data-scroll={item.id} data-nav-link={item.id} class="nav__link">
          <span class="nav__roll" data-text={item.label}><span>{item.label}</span></span>
          {lamina(item.id) && <span class="nav__n mono" aria-hidden="true">L{lamina(item.id)}</span>}
        </a>
      ))}
    </nav>

    <div class="nav__right">
      <a href="#rsvp" data-scroll="rsvp" class="btn nav__cta">Confirmar <span class="arrow">→</span></a>
      <button class="nav__burger mono" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="nav__burger-label" data-open-label>Menú</span>
        <span class="nav__burger-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="menu" data-menu aria-hidden="true">
  <div class="menu__inner">
    <ol class="menu__list">
      {nav.map((item) => (
        <li>
          <a href={`#${item.id}`} data-scroll={item.id} class="menu__link" tabindex="-1">
            <span class="menu__label">{item.label}</span>
            {lamina(item.id) && <span class="mono menu__num">L{lamina(item.id)}</span>}
          </a>
        </li>
      ))}
    </ol>
    <div class="menu__foot">
      <img src="/img/cuqui.jpg" alt="" class="menu__cuqui" width="298" height="348" />
      <p class="note">Elige lámina.<br />Yo ya he elegido siesta.</p>
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 900;
    transition: transform .5s var(--ease);
  }
  /* En algunos navegadores móviles (Brave, Safari) la zona de arriba, bajo la hora y el notch, queda por encima
     del header y deja ver el contenido: este "tapón" prolonga el color del header hacia arriba para cubrirla */
  .nav::before {
    content: ''; position: absolute; left: 0; right: 0; bottom: 100%; height: 320px;
    background: var(--paper); pointer-events: none;
  }
  .nav__bar {
    height: var(--nav-h);
    display: flex; align-items: stretch; justify-content: space-between; gap: 0;
    padding: 0;
    padding-top: env(safe-area-inset-top);
    background: var(--paper);
    border-bottom: 1px solid var(--line-strong);
  }
  .nav__logo { display: flex; align-items: center; text-decoration: none; flex: none; }
  .nav__logo { perspective: 700px; flex: 1 1 auto; min-width: 0; position: relative; overflow: hidden; isolation: isolate; align-self: stretch; }
  /* Hover: el fondo se rellena de verde (sube desde abajo) y el logo pasa a blanco, como en los botones */
  .nav__logo::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--red);
    transform: translateY(101%); border-radius: 50% 50% 0 0;
    transition: transform .5s var(--ease), border-radius .5s var(--ease);
  }
  .nav__logo:hover::before, .nav__logo:focus-visible::before { transform: translateY(0); border-radius: 0; }
  .sign__face--front { transition: color .4s var(--ease); }
  .nav__logo:hover .sign__face--front, .nav__logo:focus-visible .sign__face--front { color: #fff; }
  .sign {
    position: relative; display: block;
    width: 100%; height: var(--nav-h);
    
  }
  .sign__face {
    position: absolute; inset: 0; display: grid; place-items: center;
    -webkit-backface-visibility: hidden; backface-visibility: hidden;
    background: transparent; color: var(--ink);
    white-space: nowrap; overflow: hidden;
  }
  .sign__face--front { font-family: var(--f-rough); font-size: 30px; line-height: 1; padding-top: 3px; text-align: center; overflow: visible; }
  .sign__fit { display: inline-block; white-space: nowrap; line-height: 1; }
  .nav__links { display: none; }
  .nav__link {
    position: relative; display: flex; align-items: center; justify-content: center;
    font-family: var(--f-futura); font-weight: 500; font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase;
    text-decoration: none; overflow: hidden; isolation: isolate;
    transition: color .4s var(--ease);
  }
  /* un solo borde como separador: entre el logo y el primer botón y entre botones; sin borde en el extremo derecho */
  .nav__link { border-left: 1px solid var(--line-strong); }
  /* relleno del botón */
  .nav__link::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--red);
    transform: translateY(101%); border-radius: 50% 50% 0 0;
    transition: transform .5s var(--ease), border-radius .5s var(--ease);
  }
  .nav__link:hover::before, .nav__link.is-active::before { transform: translateY(0); border-radius: 0; }
  /* ¿Vienes?: fondo oscuro en reposo; al pasar el ratón se rellena como los demás */
  .nav__link[data-nav-link='rsvp'] { background: var(--ink); color: #fff; }
  /* número de lámina: pequeño, en la esquina inferior derecha del botón */
  .nav__n {
    position: absolute; right: 8px; bottom: 6px; font-size: 9px; line-height: 1; letter-spacing: .06em;
    color: var(--ink-3); transition: color .4s var(--ease);
  }
  .nav__link:hover .nav__n, .nav__link.is-active .nav__n { color: #fff; }
  /* texto que gira y pasa a blanco */
  .nav__roll { position: relative; display: inline-block; overflow: hidden; line-height: 1.5; }
  .nav__roll > span { display: inline-block; transition: transform .45s var(--ease); }
  .nav__roll::after {
    content: attr(data-text); position: absolute; left: 0; top: 100%; color: #fff;
    transition: transform .45s var(--ease);
  }
  .nav__link:hover .nav__roll > span, .nav__link:hover .nav__roll::after { transform: translateY(-100%); }
  .nav__link.is-active .nav__roll > span, .nav__link.is-active .nav__roll::after { transform: translateY(-100%); }

  /* Derecha (móvil/tablet): celdas pegadas al borde, separadas por una línea, igual que los apartados del header de escritorio */
  .nav__right { display: flex; align-items: stretch; gap: 0; }
  .nav__cta {
    min-height: 0; padding: 0 20px; border-radius: 0; border-width: 0 0 0 1px; border-color: var(--line-strong);
    font-family: var(--f-futura); font-weight: 500; font-size: 12.5px; letter-spacing: .08em;
  }
  .nav__cta:hover { border-color: var(--line-strong); }
  .nav__burger {
    position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    min-width: 116px; min-height: 0; padding: 0 18px;
    border: 0; border-left: 1px solid var(--line-strong); border-radius: 0; background: transparent; color: var(--ink);
    font-family: var(--f-futura); font-weight: 500; font-size: 12.5px; letter-spacing: .08em; text-transform: uppercase;
    overflow: hidden; isolation: isolate; transition: color .4s var(--ease);
  }
  .nav__burger::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--red);
    transform: translateY(101%); border-radius: 50% 50% 0 0;
    transition: transform .5s var(--ease), border-radius .5s var(--ease);
  }
  /* el relleno verde solo con ratón: en táctil el hover se quedaría "pegado" tras tocar */
  @media (hover: hover) {
    .nav__burger:hover, .nav__burger:focus-visible { color: #fff; }
    .nav__burger:hover::before, .nav__burger:focus-visible::before { transform: translateY(0); border-radius: 0; }
  }
  .nav__burger-icon { display: grid; gap: 4px; width: 16px; }
  .nav__burger-icon i { display: block; height: 1.5px; background: currentColor; transition: transform .4s var(--ease); }
  .nav__burger[aria-expanded='true'] .nav__burger-icon i:first-child { transform: translateY(2.75px) rotate(45deg); }
  .nav__burger[aria-expanded='true'] .nav__burger-icon i:last-child { transform: translateY(-2.75px) rotate(-45deg); }


  @media (max-width: 420px) {
    .nav__cta { display: none; }
  }
  @media (min-width: 1180px) {
    /* botones iguales, pegados a la derecha; el espacio sobrante es para el logo */
    .nav__bar { padding-right: 0; align-items: stretch; }
    .nav__logo { align-self: center; }
    .nav__right { display: none; }
    .nav__links {
      display: grid; grid-template-columns: repeat(8, 1fr);
      width: min(80vw, 8 * 150px); margin-left: auto;
      width: round(down, min(80vw, 8 * 150px), 8px); /* columnas de píxeles enteros: el separador no se ve más grueso */
    }
  }

  /* Menú desplegable: sale por debajo del header, con el color de fondo de la web */
  .menu {
    position: fixed; left: 0; right: 0; top: var(--nav-h); bottom: 0; z-index: 890;
    background: var(--paper); color: var(--ink);
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    overflow: hidden;
  }
  .menu.is-open { visibility: visible; }
  /* Margen lateral con las líneas del marco de la página; el primer enlace arranca justo bajo el borde del header */
  .menu__inner {
    height: 100%; overflow: hidden; margin: 0 var(--gutter); border-inline: 1px solid var(--frame-line, var(--line-strong));
    display: flex; flex-direction: column;
  }
  /* Cabe siempre en la pantalla: los enlaces se reparten el alto disponible (sin scroll interno) */
  .menu__list { list-style: none; margin: 0; padding: 0; flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
  .menu__list li { flex: 1 1 0; min-height: 0; border-bottom: 1px solid var(--line-strong); overflow: hidden; }
  .menu__link {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 100%; padding: 0 var(--pad-x); text-decoration: none; color: var(--ink);
  }
  .menu__label {
    display: inline-block; font-family: var(--f-futura);
    font-size: clamp(1.5rem, 7vw, 2.2rem); line-height: 1.05; text-transform: uppercase; font-weight: 500;
    transition: color .3s;
  }
  .menu__num { color: var(--ink); font-size: 11.5px; }
  .menu__link:hover .menu__label, .menu__link:focus-visible .menu__label { color: var(--red); }
  .menu__foot { flex: none; display: flex; align-items: flex-end; gap: 14px; padding: 20px var(--pad-x) 0; }
  /* pantallas bajas: se quita el gato para que los enlaces respiren */
  @media (max-height: 760px) { .menu__foot { display: none; } }
  .menu__cuqui { width: 84px; height: auto; border-radius: 42px 42px 0 0; filter: grayscale(1); }
  .menu .note { color: var(--ink); font-size: 1.5rem; margin: 0; }
</style>
