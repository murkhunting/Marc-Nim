---
import SheetHead from './SheetHead.astro';
import { itinerary } from '../data/site';

const START = 17 * 60;
const SPAN = 9 * 60 + 60; // 17:00 → 03:00
const toMin = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  let v = h * 60 + m;
  if (v < START) v += 24 * 60;
  return v - START;
};
const bars = itinerary.map((it) => {
  const a = toMin(it.time);
  const b = it.end === '+' ? SPAN : toMin(it.end);
  return { left: (a / SPAN) * 100, width: Math.max(((b - a) / SPAN) * 100, 2), open: it.end === '+' };
});

// Transporte el día de la boda: un circuito que sale y vuelve al mismo punto. [PENDIENTE] horas y punto exacto
const bus = [
  { time: '16:15', tag: 'Salida', name: 'Santa Eulària des Riu', place: 'Punto de recogida', text: 'Os recogemos en el pueblo. El punto exacto os lo confirmaremos.' },
  { time: '16:45', tag: 'Llegada', name: 'Iglesia de Sant Carles', place: 'Ceremonia · 17:00', text: 'Os dejamos en la puerta con tiempo para encontrar sitio.' },
  { time: '18:00', tag: 'Traslado', name: 'Can Curreu', place: 'Aperitivo, cena y fiesta', text: 'Al acabar la ceremonia, os llevamos a la finca (1,5 km).' },
  { time: '02:00', tag: 'Regreso', name: 'Santa Eulària des Riu', place: 'Mismo punto de recogida', text: 'Al cerrar la fiesta, os devolvemos al punto de salida.' },
];

const icons: Record<string, string> = {
  church: '<path d="M16 3v6M13 6h6M8 30V17l8-7 8 7v13M4 30h24M13 30v-6a3 3 0 0 1 6 0v6"/>',
  door: '<path d="M7 30V8a9 9 0 0 1 18 0v22M4 30h24M19 19h.01"/>',
  glass: '<path d="M9 4h14l-1 8a6 6 0 0 1-12 0L9 4ZM16 18v10M11 28h10M10 9h12"/>',
  plate: '<circle cx="16" cy="17" r="10"/><circle cx="16" cy="17" r="5.5"/><path d="M3 4v8M5 4v8M3 12v16M29 4c-2 2-2 8 0 9v15"/>',
  disco: '<circle cx="16" cy="18" r="10"/><path d="M16 2v6M6 18h20M16 8c-3 3-4 6-4 10s1 7 4 10M16 8c3 3 4 6 4 10s-1 7-4 10M8 12h16M8 24h16"/>',
  moon: '<path d="M24 21A11 11 0 1 1 13 6a8.5 8.5 0 0 0 11 15Z"/><path d="M24 5v4M22 7h4"/>',
};
---
<section id="itinerario" class="iti section--flush" data-flush data-section="itinerario" data-iti>
  <SheetHead
    n={3}
    label="Planning de obra"
    title={'El día de la boda'}
    sub="Del sí, quiero a lo que surja. Horario provisional: os confirmaremos las horas exactas más adelante."
    note="17:00 → 02:00+"
  />
  <div class="sheet-content iti__sky" data-iti-sky>
    <div class="iti__stars" aria-hidden="true" data-iti-stars>
      {Array.from({ length: 40 }).map((_, i) => (
        <i style={`left:${(i * 37) % 100}%;top:${(i * 53) % 100}%;--d:${(i % 7) * 0.4}s`} />
      ))}
    </div>

    <div class="iti__body">
      <div class="iti__rail" aria-hidden="true">
        <span class="iti__fill" data-iti-fill></span>
        <span class="iti__orb" data-iti-orb>
          <svg class="iti__sun" viewBox="0 0 40 40"><circle cx="20" cy="20" r="8" /><g stroke-width="2" stroke-linecap="round">{Array.from({ length: 8 }).map((_, i) => <line x1="20" y1="3" x2="20" y2="8" transform={`rotate(${i * 45} 20 20)`} />)}</g></svg>
          <svg class="iti__moon" viewBox="0 0 40 40"><path d="M28 25A11 11 0 1 1 17 9a8.5 8.5 0 0 0 11 16Z" /></svg>
        </span>
      </div>

      <ol class="iti__list">
        {itinerary.map((it, i) => (
          <li class="iti__item" data-iti-item>
            <div class="iti__time">
              <span class="iti__hour">{it.time}</span>
              <span class="mono iti__end">→ {it.end === '+' ? '∞' : it.end}</span>
            </div>
            <div class="iti__content">
              <div class="iti__head">
                <svg class="iti__icon" viewBox="0 0 32 32" aria-hidden="true" set:html={icons[it.icon]} />
                <div>
                  <h3 class="iti__title">{it.title}</h3>
                  <p class="mono iti__place">{it.place}</p>
                </div>
              </div>
              <p class="iti__text">{it.text}</p>
              <div class="iti__gantt" aria-hidden="true">
                <span class:list={['iti__bar', { 'is-open': bars[i].open }]} style={`left:${bars[i].left}%;width:${bars[i].width}%`} />
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- Transporte el día de la boda: esquema de línea (ida, traslado y vuelta al mismo punto) -->
  <div class="bus">
    <div class="bus__head">
      <div class="bus__intro">
        <h3 class="bus__title">Transporte el día de la boda</h3>
        <p class="bus__sub">Para los que venís de fuera, nosotros nos encargamos de llevaros y traeros. Un autobús saldrá de Santa Eulària des Riu, os llevará a la iglesia, después a Can Curreu y, a las 2 de la madrugada, os devolverá al mismo punto. Sin preocuparos por aparcar ni por quién conduce.</p>
      </div>
      <svg class="bus__icon" viewBox="0 0 32 32" aria-hidden="true"><path d="M6 24V8a4 4 0 0 1 4-4h12a4 4 0 0 1 4 4v16M6 24h20M6 15h20M10 4v11M22 4v11"/><circle cx="10.5" cy="20" r="1.4"/><circle cx="21.5" cy="20" r="1.4"/><path d="M8 24v3h3v-3M21 24v3h3v-3"/></svg>
    </div>

    <div class="bus__route" data-bus-route>
    <ol class="bus__line">
      {bus.map((b, i) => (
        <li class:list={['bus__stop', { 'is-home': i === 0 || i === bus.length - 1 }]} data-reveal>
          <span class="bus__node" aria-hidden="true"><i>{i === bus.length - 1 ? 'A' : String.fromCharCode(65 + i)}</i></span>
          <p class="mono bus__tag">{String(i + 1).padStart(2, '0')} - {b.tag}</p>
          <p class="bus__time">{b.time}</p>
          <h4 class="bus__name">{b.name}</h4>
          <p class="mono bus__place">{b.place}</p>
          <p class="bus__text">{b.text}</p>
        </li>
      ))}
    </ol>
    <!-- Autobús en perfil: recorre A → B → C → A y se repite -->
    <span class="bus__rider" data-bus-rider aria-hidden="true">
      <svg viewBox="0 0 48 26"><path d="M2 3a2 2 0 0 1 2-2h34c3 0 6 3 7 8l1 6v6H2z" /><g class="bus__win"><rect x="6" y="5" width="6" height="6" /><rect x="14" y="5" width="6" height="6" /><rect x="22" y="5" width="6" height="6" /><path d="M31 5h6l3 6h-9z" /></g><circle class="bus__wheel" cx="12" cy="21" r="3.6" /><circle class="bus__wheel" cx="36" cy="21" r="3.6" /></svg>
    </span>
    </div>

    <p class="bus__note mono">
      <span>Horas orientativas · os las confirmaremos más adelante</span>
      <strong class="bus__warn">¡¡¡Importante que se marque en la invitación!!!</strong>
    </p>
  </div>
</section>

<style>
  /* Solo la parte del planning cambia de cielo; el título y el subtítulo conservan los colores de la web */
  .iti__sky {
    --bg: #5aa8e2; --fg: #ffffff; --muted: rgba(255,255,255,.85); --ln: rgba(255,255,255,.4);
    position: relative; overflow: hidden; background: var(--bg); color: var(--fg);
  }
  .iti__sky > :not(.iti__stars) { position: relative; }
  .iti__stars { position: absolute; inset: 0; opacity: 0; pointer-events: none; }
  .iti__stars i {
    position: absolute; width: 2px; height: 2px; border-radius: 50%; background: #ebebed;
    animation: twinkle 3s ease-in-out var(--d) infinite;
  }
  @keyframes twinkle { 50% { opacity: .2; } }

  .iti__body { position: relative; display: grid; grid-template-columns: 34px 1fr; gap: 0 18px; }
  .iti__rail { position: relative; }
  .iti__rail::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; background: var(--ln); }
  .iti__fill { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; margin-left: -.5px; background: var(--fg); transform-origin: top; transform: scaleY(0); }
  .iti__orb {
    position: absolute; left: 50%; top: 0; width: 34px; height: 34px; margin-left: -17px;
    display: grid; place-items: center; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--fg);
  }
  .iti__orb svg { position: absolute; width: 24px; height: 24px; }
  .iti__sun { fill: #fff; stroke: #fff; }
  .iti__moon { fill: #ebebed; opacity: 0; }

  .iti__list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(40px, 6vw, 72px); }
  .iti__item { display: grid; gap: 10px; }
  .iti__time { display: flex; align-items: baseline; gap: 12px; }
  .iti__hour { font-size: clamp(2.6rem, 8vw, 5.4rem); line-height: .9; font-weight: 400; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .iti__end { color: var(--muted); }
  .iti__head { display: flex; gap: 14px; align-items: center; }
  .iti__icon { width: 40px; height: 40px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .iti__title { margin: 0; font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 600; text-transform: uppercase; line-height: 1; }
  .iti__place { margin: 4px 0 0; color: var(--muted); }
  .iti__text { margin: 10px 0 0; color: var(--muted); max-width: 44ch; font-size: 1.05rem; }
  .iti__gantt { position: relative; height: 8px; margin-top: 14px; border-left: 1px solid var(--ln); border-right: 1px solid var(--ln);
    background: repeating-linear-gradient(90deg, var(--ln) 0 1px, transparent 1px calc(100% / 10)); max-width: 520px; }
  .iti__bar { position: absolute; top: 1px; bottom: 1px; background: var(--fg); transform-origin: left; }
  .iti__bar.is-open { background: linear-gradient(90deg, var(--red), transparent); }

  @media (min-width: 900px) {
    .iti__body { grid-template-columns: 1fr 60px 1.25fr; gap: 0 40px; }
    .iti__rail { grid-column: 2; grid-row: 1; }
    .iti__list { grid-column: 1 / -1; grid-row: 1; }
    .iti__item { grid-template-columns: 1fr 60px 1.25fr; gap: 0 40px; align-items: start; }
    .iti__time { grid-column: 1; justify-content: flex-end; flex-direction: column; align-items: flex-end; text-align: right; }
    .iti__content { grid-column: 3; }
    .iti__hour { font-size: clamp(4rem, 7vw, 7rem); }
  }
  /* ── Transporte el día de la boda ─────────────────────────── */
  .bus { border-bottom: 1px solid var(--frame-line, var(--line-strong)); }
  .bus__head {
    display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: start;
    padding: clamp(28px, 4vw, 48px) var(--pad-x); border-bottom: 1px solid var(--line-strong);
  }
  /* icono grande, en negro y sin fondo */
  .bus__icon {
    width: clamp(84px, 11vw, 132px); height: clamp(84px, 11vw, 132px);
    fill: none; stroke: var(--ink); stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round;
  }
  .bus__title { margin: 0; font-size: clamp(1.8rem, 4vw, 3rem); font-weight: 500; text-transform: uppercase; line-height: 1; }
  .bus__sub { margin: 14px 0 0; color: var(--ink-2); max-width: 62ch; }

  /* Paradas: celdas pegadas con bordes compartidos; la línea del recorrido las une por arriba */
  .bus__route { position: relative; isolation: isolate; }
  .bus__line { list-style: none; margin: 0; padding: 0; display: grid; }
  /* Capas: línea discontinua < autobús < indicadores (el bus entra y sale "de" cada letra) */
  .bus__stop::before { z-index: 0; }
  .bus__rider { position: absolute; left: 0; top: 0; z-index: 2; width: 38px; height: 21px; pointer-events: none; opacity: 0; }
  .bus__rider svg { display: block; width: 100%; height: 100%; fill: var(--red); }
  .bus__rider .bus__win { fill: #fff; }
  .bus__rider .bus__wheel { fill: var(--ink); stroke: #fff; stroke-width: 1.2; }
  .bus__stop {
    position: relative; display: grid; gap: 4px; align-content: start;
    --n: 40px; padding: 18px var(--pad-x) 24px calc(var(--pad-x) + var(--n) + 14px); border-bottom: 1px solid var(--line-strong);
  }
  .bus__stop:last-child { border-bottom: 0; }
  .bus__stop p, .bus__stop h4 { margin: 0; }
  /* móvil: línea vertical a la izquierda */
  .bus__stop::before {
    content: ''; position: absolute; left: calc(var(--pad-x) + var(--n) / 2 - 1px); top: 0; bottom: 0;
    border-left: 2px dashed var(--paper-3);
  }
  /* la línea empieza en la primera A y acaba en la última A (sin tramos sueltos fuera) */
  .bus__stop:first-child::before { top: calc(16px + var(--n) / 2); }
  .bus__stop:last-child::before { bottom: auto; height: calc(16px + var(--n) / 2); }
  .bus__node {
    position: absolute; left: var(--pad-x); top: 16px; width: var(--n); height: var(--n); display: grid; place-items: center;
    background: var(--ink); color: #fff; z-index: 3;
  }
  .bus__node i { font-style: normal; font-family: var(--f-mono); font-size: 16px; font-weight: 500; line-height: 1; }
  .bus__stop.is-home .bus__node { background: var(--red); }
  .bus__tag { color: var(--ink-3); }
  .bus__time { font-size: clamp(2.4rem, 5vw, 3.6rem); line-height: .95; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; margin-top: 6px !important; }
  .bus__name { font-size: 1.15rem; font-weight: 600; text-transform: uppercase; line-height: 1.1; margin-top: 8px !important; }
  .bus__place { color: var(--red); }
  .bus__text { color: var(--ink-2); font-size: .98rem; margin-top: 6px !important; max-width: 36ch; }

  .bus__note {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 20px; margin: 0;
    padding: 16px var(--pad-x); border-top: 1px solid var(--line-strong); color: var(--ink-3);
  }
  .bus__note { align-items: center; }
  .bus__warn { color: var(--ink); font-weight: 500; font-size: clamp(14px, 1.3vw, 17px); letter-spacing: .06em; }

  @media (min-width: 900px) {
    .bus__line { grid-template-columns: repeat(4, 1fr); }
    .bus__stop { padding: 84px var(--pad-x) 28px; border-bottom: 0; border-right: 1px solid var(--line-strong); }
    .bus__stop:last-child { border-right: 0; }
    /* escritorio: línea horizontal que une los nodos */
    /* escritorio: la línea va de lado a lado y el nodo queda alineado con el texto de la parada */
    .bus__stop::before { left: 0; right: 0; top: 40px; bottom: auto; height: 0; border-left: 0; border-top: 2px dashed var(--paper-3); }
    .bus__stop:first-child::before { left: calc(var(--pad-x) + var(--n) / 2); top: 40px; }
    .bus__stop:last-child::before { right: auto; width: calc(var(--pad-x) + var(--n) / 2); height: 0; }
    .bus__node { top: 20px; left: var(--pad-x); }
  }
</style>
