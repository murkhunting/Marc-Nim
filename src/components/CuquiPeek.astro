---
import '@fontsource/schoolbell/400.css';
import { cuquiLines } from '../data/site';
---
<aside class="peek" data-peek data-lines={JSON.stringify(cuquiLines)} aria-live="polite">
  <p class="peek__bubble" data-peek-bubble>
    <span class="peek__text" data-peek-text></span>
  </p>
  <button class="peek__cat" data-peek-cat aria-label="Hablar con Orión, el promotor">
    <img src="/img/orion2.webp" alt="" width="640" height="681" />
  </button>
</aside>

<style>
  .peek {
    position: fixed; right: env(safe-area-inset-right, 0px); bottom: 0; z-index: 800;
    display: flex; align-items: flex-end; gap: 14px;
    pointer-events: none;
    /* misma sombra para Orión y para el bocadillo */
    --peek-shadow: drop-shadow(0 6px 14px rgba(23, 25, 29, .38));
    --peek-img: contrast(1.12) saturate(1.1);
    --peek-line: #5a5c62;
  }
  .peek__cat {
    pointer-events: auto; flex: none;
    width: clamp(80px, 8.6vw, 118px); aspect-ratio: 640 / 681;
    padding: 0; border: 0; background: none; cursor: pointer;
    transform: translateY(105%);
  }
  .peek__cat img { display: block; width: 100%; height: auto; filter: var(--peek-img) var(--peek-shadow); }

  /* Bocadillo de cómic: globo blanco con línea fina y rabillo curvo hacia Orión */
  .peek__bubble {
    position: relative; margin: 0 0 clamp(48px, 6.4vw, 76px);
    max-width: min(188px, 52vw);
    padding: 11px 16px 13px;
    background: #fff; border: 1.25px solid var(--peek-line); border-radius: 24px 26px 24px 20px / 20px 22px 26px 22px;
    filter: var(--peek-shadow);
    opacity: 0; transform: translateY(10px) scale(.9); transform-origin: right bottom;
  }
  /* rabillo: triángulo pequeño; el relleno blanco tapa el borde del globo en la unión */
  .peek__bubble::after {
    content: ''; position: absolute; right: -13px; bottom: 11px; width: 16px; height: 14px;
    background: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 14'><path d='M0 1L16 11L0 13Z' fill='white'/><path d='M0 1L16 11L0 13' fill='none' stroke='%235a5c62' stroke-width='1.25' stroke-linejoin='miter'/></svg>") no-repeat center / 100% 100%;
  }
  .peek__text {
    display: block; font-family: 'Schoolbell', cursive; font-weight: 400;
    font-size: 1.12rem; line-height: 1.22; color: var(--ink);
  }
  html.reduce .peek__cat { transform: translateY(18%); }
  @media (max-width: 600px) {
    .peek { gap: 12px; }
    .peek__cat { width: 82px; }
    .peek__bubble { max-width: 148px; padding: 9px 13px 11px; margin-bottom: 46px; }
    .peek__text { font-size: .98rem; }
  }
</style>
